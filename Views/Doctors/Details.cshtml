@model HUTECH_Hospital.Models.Doctor
@{
    ViewData["Title"] = "Hồ sơ BS. " + Model.FullName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-section bg-light pt-5 pb-4 mt-5">
    <div class="container reveal-up">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i></a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Đội Ngũ Bác Sĩ</a></li>
                <li class="breadcrumb-item active fw-bold" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>
    </div>
</section>

<section class="page-section">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-4 text-center reveal-left">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" class="w-100" style="object-fit:cover; aspect-ratio: 3/4;" />
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@(Model.FullName)&background=random&size=800" class="w-100" style="object-fit:cover; aspect-ratio: 3/4;" />
                    }
                </div>

                <div class="glass-card text-start border shadow-sm">
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">Tóm tắt Chuyên môn</h5>
                    <p class="mb-2"><i class="fa-solid fa-building text-muted me-2 border bg-white p-2 rounded-circle"></i>Khoa: <strong>@(Model.Department?.Name ?? "Chưa rõ")</strong></p>
                    <p class="mb-2"><i class="fa-solid fa-award text-muted me-2 border bg-white p-2 rounded-circle"></i>Học vị: <strong>@Model.Degree</strong></p>
                    <p class="mb-2"><i class="fa-solid fa-stethoscope text-muted me-2 border bg-white p-2 rounded-circle"></i>Chuyên khoa: <strong>@Model.Specialization</strong></p>
                    <p class="mb-0"><i class="fa-solid fa-stopwatch text-muted me-2 border bg-white p-2 rounded-circle"></i>Kinh nghiệm: <strong>Thâm niên @Model.ExperienceYears năm</strong></p>
                </div>

                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 mb-2 rounded-pill"><i class="fa-solid fa-arrow-left me-2"></i>Quay lại danh sách</a>
                    <a asp-controller="Appointment" asp-action="Create" asp-route-doctorId="@Model.Id" class="btn btn-medical-primary w-100 rounded-pill"><i class="fa-regular fa-calendar-check me-2"></i>Đặt lịch khám</a>
                </div>
            </div>

            <div class="col-lg-8 reveal-right">
                <h1 class="fw-bold text-dark mb-1">BS @Model.Degree. @Model.FullName</h1>
<p class="text-primary fs-5 mb-4">@Model.Specialization</p>

                <h4 class="fw-bold text-dark border-bottom pb-2 mb-4"><i class="fa-solid fa-file-medical text-primary me-2"></i>Quá trình công tác</h4>
                <div class="mb-5 text-muted lh-lg">
                    @Html.Raw((Model.Description ?? "Hệ thống đang thu thập tiểu sử chuyên môn.").Replace("\n", "<br/>"))
                </div>
                @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Doctor")))
                {
                    <!-- Upcoming Appointments Section -->
                    @if (ViewBag.UpcomingAppointments != null && ((List<HUTECH_Hospital.Models.Appointment>)ViewBag.UpcomingAppointments).Any())
                    {
                        <div class="card border border-info-subtle shadow-sm rounded-4 bg-info bg-opacity-10 overflow-hidden">
                            <div class="card-header bg-info text-white p-4">
                                <h4 class="fw-bold m-0"><i class="fa-solid fa-calendar-days me-2"></i>Tất Cả Cuộc Hẹn Sắp Tới</h4>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Ngày giờ hẹn</th>
                                                <th>Hồ sơ bệnh nhân</th>
                                                <th>Lý do vào viện</th>
                                                <th>Phân loại</th>
                                                <th>Chi tiết</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var appointment in ((List<HUTECH_Hospital.Models.Appointment>)ViewBag.UpcomingAppointments).Take(10))
                                            {
                                                <tr>
                                                    <td>
                                                        <strong>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</strong><br />
                                                        <small class="text-muted"><i class="fa-solid fa-clock me-1"></i>@appointment.AppointmentTime.ToString(@"hh\:mm")</small>
                                                    </td>
                                                    <td>
                                                        <strong>@appointment.Patient?.FullName</strong><br />
                                                        <small class="text-muted">@appointment.Patient?.StudentCode</small>
</td>
                                                    <td>
                                                        @if (appointment.Reason == "Tái khám")
                                                        {
                                                            <span class="badge bg-success">@appointment.Reason</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@appointment.Reason</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @switch (appointment.Status)
                                                        {
                                                            case "Pending":
                                                                <span class="badge bg-warning">Hộ số</span>
                                                                break;
                                                            case "Confirmed":
                                                                <span class="badge bg-success">Có lịch</span>
                                                                break;
                                                            case "Completed":
                                                                <span class="badge bg-info">Đã hoàn thành</span>
                                                                break;
                                                            case "Cancelled":
                                                                <span class="badge bg-danger">Đã hủy</span>
                                                                break;
                                                            default:
                                                                <span class="badge bg-secondary">@appointment.Status</span>
                                                                break;
                                                        }
                                                    </td>
                                                    <td>
                                                        <a href="/Appointment/Details/@appointment.Id" class="btn btn-sm btn-outline-info rounded-pill">
                                                            <i class="fa-solid fa-eye me-1"></i>Hộ số
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="fa-solid fa-circle-info me-2"></i>
                            <strong>Thông báo:</strong> Hiện không có cuộc hẹn sắp tới nào được lên lịch.
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
