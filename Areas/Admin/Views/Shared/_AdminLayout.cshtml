<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HUTECH Hospital System</title>
    
    <link rel="icon" type="image/png" href="~/uploads/doctors/logo-hutech.png" />
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- FontAwesome 6 Free Solid -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Custom Admin Styles -->
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-bg">
    <div class="admin-shell">
        
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <a href="/Admin" class="admin-sidebar-brand">
                <img src="~/uploads/doctors/logo-hutech.png" alt="HUTECH Logo" />
                <span>HUTECH<br>HOSPITAL</span>
            </a>
            
            <nav class="admin-nav">
                <div class="admin-sidebar-section-title">Trang Chủ</div>
                <div class="admin-nav-item">
                    <a href="/Admin" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-chart-pie"></i></span>
                        Tổng quan Admin
                    </a>
                </div>
                
                <div class="admin-sidebar-section-title">Quản Trị Y Tế</div>
                <div class="admin-nav-item">
                    <a href="/Admin/Department" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-hospital-user"></i></span>
                        Quản lý Chuyên khoa
                    </a>
                </div>
                <div class="admin-nav-item">
                    <a href="/Admin/Doctor" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-user-doctor"></i></span>
                        Vận hành Bác sĩ
                    </a>
                </div>
                <div class="admin-nav-item">
                    <a href="/Admin/DoctorSchedule" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-calendar-days"></i></span>
                        Phân ca lịch trực
                    </a>
                </div>
                <div class="admin-nav-item">
                    <a href="/Admin/Appointment" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-file-medical"></i></span>
                        Quản lý Phiếu khám
                    </a>
                </div>
                
                <div class="admin-sidebar-section-title">Nghiệp Vụ Lâm Sàng</div>
                <div class="admin-nav-item">
                    <a href="/Admin/MedicalRecord" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-notes-medical"></i></span>
                        Kho Hồ sơ EHR
                    </a>
                </div>
                <div class="admin-nav-item">
                    <a href="/Admin/Medicine" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-pills"></i></span>
                        Danh mục Thuốc
                    </a>
                </div>
                
                <div class="admin-sidebar-section-title">Truyền Thông & CSKH</div>
                <div class="admin-nav-item">
                    <a href="/Admin/Notification" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-bell"></i></span>
                        Gửi Thông báo
                    </a>
                </div>
                <div class="admin-nav-item">
                    <a href="/Admin/Feedback" class="admin-nav-link">
                        <span class="admin-nav-icon"><i class="fa-solid fa-comments"></i></span>
                        Phản hồi & CSKH
                    </a>
                </div>
                
                <div class="admin-sidebar-section-title">Hệ Thống</div>
                <div class="admin-nav-item">
                    <a href="/" class="admin-nav-link text-info" target="_blank">
                        <span class="admin-nav-icon"><i class="fa-solid fa-globe"></i></span>
                        Xem Website Bệnh viện
                    </a>
                </div>
            </nav>
            
            <div class="admin-sidebar-footer">
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                    <button type="submit" class="btn btn-light w-100 text-danger fw-bold rounded-pill shadow-sm py-2">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar glass-panel">
                <div class="topbar-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h4 class="topbar-title">HUTECH Hospital System Manager</h4>
                </div>
                
                <div class="admin-profile-card">
                    <div class="profile-avatar">
                        <i class="fa-solid fa-user-nurse"></i>
                    </div>
                    <div class="profile-info d-none d-md-flex">
                        <span class="profile-name">@User.Identity?.Name</span>
                        <span class="profile-status"><i class="fa-solid fa-circle"></i> Online</span>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dashboard-container">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin.js"></script>
    
    <!-- Fix script for new Sidebar DOM structure -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Update Active Menu logic for the new DOM structure (.admin-nav-link)
            const currentPath = window.location.pathname.toLowerCase();
            const menuLinks = document.querySelectorAll('.admin-nav-link');

            menuLinks.forEach(link => {
                const itemPath = link.getAttribute('href').toLowerCase();
                link.classList.remove('active');

                if (currentPath === itemPath) {
                    link.classList.add('active');
                } else if (itemPath !== '/admin' && currentPath.startsWith(itemPath + '/')) {
                    link.classList.add('active');
                }
            });

            if (currentPath === '/admin' || currentPath === '/admin/') {
                const dashLink = document.querySelector('.admin-nav-link[href="/Admin"]');
                if (dashLink) dashLink.classList.add('active');
            }
        });
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
